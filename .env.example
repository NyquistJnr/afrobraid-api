# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/afrobraid
# Set to true to log every SQL statement (verbose) — off by default even in debug mode.
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / tokens ---
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REMEMBER_ME_ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=30
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=90

# --- OTP ---
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# --- Email (Resend) ---
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM="Afrobraid <no-reply@afrobraid.com>"

# --- i18n ---
SUPPORTED_LOCALES=en,fr,de
DEFAULT_LOCALE=en

# --- OAuth providers (placeholders until real apps are created) ---
GOOGLE_CLIENT_ID=CHANGE_ME
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME
TIKTOK_CLIENT_KEY=CHANGE_ME
TIKTOK_CLIENT_SECRET=CHANGE_ME

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Cloudflare R2 (media uploads) ---
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=afrobraid-media
R2_ENDPOINT_URL=https://CHANGE_ME.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://media.afrobraid.com

# --- DeepL (bio auto-translation) ---
# Use https://api.deepl.com/v2/translate instead if/when you're on a Pro plan.
DEEPL_API_KEY=CHANGE_ME
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# --- Veriff (identity verification) ---
# API key + shared secret from Veriff Customer Portal > Integration > API keys.
VERIFF_API_KEY=CHANGE_ME
VERIFF_SECRET_KEY=CHANGE_ME
VERIFF_API_URL=https://stationapi.veriff.com/v1
# Frontend page the end-user lands on after finishing the hosted Veriff flow.
VERIFF_CALLBACK_URL=https://CHANGE_ME/onboarding/veriff/complete

# --- Twilio (phone verification via Verify API) ---
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
# Verify Service SID from Twilio Console > Verify > Services (starts with "VA").
TWILIO_VERIFY_SERVICE_SID=CHANGE_ME
TWILIO_PHONE_NUMBER=CHANGE_ME

# Set to true to skip Twilio entirely (e.g. local/dev/test) — any send request
# succeeds without sending an SMS, and the code below is accepted as valid.
PHONE_VERIFICATION_BYPASS_ENABLED=false
PHONE_VERIFICATION_BYPASS_CODE=000000
